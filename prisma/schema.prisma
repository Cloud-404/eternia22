datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Hashed password
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  articles    Article[]
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]
}

model Article {
  id                    String    @id @default(uuid())
  slug                  String    @unique
  title                 String
  excerpt               String
  content               String    // Full MDX or Rich Text content
  readingTime           Int       // Estimated reading time in minutes
  publishedAt           DateTime  @default(now())
  status                String    @default("DRAFT") // DRAFT, PUBLISHED, SCHEDULED
  featuredImage         String    // URL or path to image
  
  // Custom Editorial Story Elements
  isStory               Boolean   @default(false) // True for student stories, false for psychology articles
  timeline              String?   // JSON string of story events [{ time: "Day 1", text: "..." }]
  copingStrategies      String?   // JSON string of coping strategies [{ title: "...", text: "..." }]
  escalationExplanation String?   // Psychological analysis of situation escalation
  
  // SEO Metadata fields
  seoTitle              String?
  seoDescription        String?
  seoKeywords           String?
  faqSchema             String?   // JSON string of Q&A for FAQ schema [{ q: "...", a: "..." }]
  structuredData        String?   // Custom JSON-LD schema
  
  // Relations
  categoryId            String
  category              Category  @relation(fields: [categoryId], references: [id])
  tags                  Tag[]
}

model Confession {
  id        String   @id @default(uuid())
  content   String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  campus    String?
  createdAt DateTime @default(now())
}

model Survey {
  id          String           @id @default(uuid())
  title       String
  description String?
  options     String           // JSON string of options ["Yes", "No", "Unsure"]
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  responses   SurveyResponse[]
}

model SurveyResponse {
  id             String   @id @default(uuid())
  surveyId       String
  survey         Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  selectedOption String
  createdAt      DateTime @default(now())
}

model Achievement {
  id          String   @id @default(uuid())
  title       String
  description String
  date        String   // e.g. "Fall 2025"
  metric      String   // e.g. "12,000+ active sessions"
  category    String   // Eternia, Campus, Community
  createdAt   DateTime @default(now())
}

model Testimonial {
  id         String   @id @default(uuid())
  quote      String
  authorName String
  authorRole String   // e.g. "Senior, Boston University"
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

